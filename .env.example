# Copy to .env. Never commit real credentials.
LINGUAAI_ENV=development
LINGUAAI_SESSION_SECRET=replace-with-at-least-32-random-characters-before-production
LINGUAAI_DATABASE=app/data/linguaai.sqlite3
LINGUAAI_LANGUAGE_MODEL=app/model_artifacts/language_model.json

# NVIDIA Nemotron example. Add a newly generated key from NVIDIA's model page.
# https://build.nvidia.com/nvidia/nemotron-3.5-lightning-30b-a3b
LINGUAAI_AI_BASE_URL=https://integrate.api.nvidia.com/v1
LINGUAAI_AI_API_KEY=
LINGUAAI_AI_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
